# Copy to .env.local for local development. NEVER commit real values (.env* is gitignored,
# except this example). On Vercel, set these in Project -> Settings -> Environment Variables.

# --- Database (Neon Postgres) -------------------------------------------------
# Runtime: the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Migrations only (drizzle-kit): the DIRECT/unpooled string. Not needed on Vercel.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Database tests (lib/db/*.test.ts) write real rows, so they read .env.test.local ONLY, never this file.
# Create a schema-only Neon branch and put its DATABASE_URL and DATABASE_URL_UNPOOLED in .env.test.local.
# Without that file the database tests are skipped.

# --- Auth.js -----------------------------------------------------------------
# Signs the session cookie. Generate a fresh one per environment:  openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Optional ------------------------------------------------------------------
# Exposes /dev/* tools in a production build (off by default; they read localStorage keys).
# ENABLE_DEV_PAGES=1

# Used ONLY by `npm run live:check` (bench/live-check.mts), never by the app.
# GROQ_API_KEY=
# GEMINI_API_KEY=
